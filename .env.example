# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Loaded by src/agent/vlm.py:load_dotenv. Values already set in your shell take precedence.

# --- Required for the TAMU reasoning backends (tamu, tamu_flash, tamu_luna, tamu_opus, tamu_sol) ---
# Used by all three agents: the identity agent (configs/agent.yaml), the BRD validation agent (stage 2, via
# run_pipeline.py, as long as there is NO brd_agent/.env) and the Level 2 risk agent (configs/risk.yaml).
# Check it with:  python check_setup.py   (docs/LAPTOP_SETUP.md)
# Get a key from the TAMU AI Chat API (tamu.ai). Without it the agent falls back to local Ollama.
TAMU_API_KEY=

# --- Fallback when TAMU fails 3 times in a row (2 s, 4 s backoff): the same model straight from OpenAI ---
# Each person uses their own key. check_setup.py sends one tiny request to prove key + model work.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna        # only if OpenAI names the model differently from TAMU's protected.gpt-5.6-luna

# --- Optional overrides (leave commented to use the configs/agent.yaml values) ---
# Backend name from configs/agent.yaml: ollama, ollama_fast, tamu, tamu_flash, tamu_luna, tamu_opus, tamu_sol, vllm
# AGENT_BACKEND=tamu_luna
# Point the selected backend at a different OpenAI-compatible endpoint, model or key
# AGENT_VLM_BASE_URL=http://localhost:11434/v1
# AGENT_VLM_MODEL=qwen2.5vl-agent
# AGENT_VLM_API_KEY=

# --- Optional: bearer token for the downstream API server (src/api/server.py --token) ---
# PEN6_API_TOKEN=
