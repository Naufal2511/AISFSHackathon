# Copy to .env (never commit .env). Real environment variables override values in this file.

# --- Provider switch ---------------------------------------------------------
# false = OpenAI API (default; for current testing)   true = local VLM (final solution)
USE_LOCAL_VLM=false

# --- OpenAI (used when USE_LOCAL_VLM=false) -----------------------------------
OPENAI_API_KEY=
# REQUIRED: the vision-capable OpenAI model you want to use. No default is assumed.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# low | high | auto  (image detail; 'low' is cheapest)
OPENAI_IMAGE_DETAIL=low
# Leave empty to omit (some models reject a temperature setting)
OPENAI_TEMPERATURE=
OPENAI_MAX_COMPLETION_TOKENS=800

# --- Local VLM (used when USE_LOCAL_VLM=true), any OpenAI-compatible server such as vLLM ---
LOCAL_VLM_BASE_URL=http://localhost:8000/v1
LOCAL_VLM_MODEL=
LOCAL_VLM_API_KEY=
LOCAL_VLM_GUIDED_JSON=false

# --- Store (CSV + JSONL files, no database) ---
BRD_STORE_DIR=data/store
