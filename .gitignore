# --- Event data: must stay within the event (never commit) ---
input/
data/
outputs/
handoff/
runs/
*.avi
*.Avi
*.AVI
*.mp4
*.mkv
*.jpg
*.jpeg
*.png
*.tar.gz
*.zip

# --- Model weights (download from Ultralytics / produced by training) ---
*.pt
*.pth
*.onnx
*.npz

# --- Environments / tooling ---
.venv/
.venv-labelstudio/
__pycache__/
*.pyc
.DS_Store
.claude/settings.local.json
*.log

# --- Secrets (API keys) ---
.env

# --- Model weights (stored with Git LFS) ---
!models/*.pt
!models/behavior/*.pt

# --- brd_agent (stage 2): real tracking sample = event data; local runs / caches ---
brd_agent/examples/tracking_sample/
brd_agent/.pytest_cache/

# --- local caches (VLM responses, may hold event data) ---
brd_agent/cache/

# --- Submission results (event data, pushed with the team's OK: keep this repo private) ---
!submission/
!submission/**
submission/**/.DS_Store

# --- Videos stay out of the repository (regenerate with the commands in README.md) ---
submission/**/*.mp4
submission/**/*.avi
# ...except the Level 2 evidence clips: the brief asks for 2-3 clips on each top-3 risk card (~33 MB)
!submission/level2/cards/clips/*.mp4

# --- The team's submission video (the one video kept in the repository) ---
!docs/media/*.mp4
!docs/media/*.jpg

# --- Level 2 BRD decision evidence clips (relevant risk clips for top-3 cows) ---
!submission/level2/cards/clips/*.mp4
